# SoundRaft Environment Configuration
# Copy this to .env and customize for your environment

# JWT Secret - REQUIRED: Generate a strong random secret
# Example: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Admin Account (seeded on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://music_user:music_pass@db:5432/music_db

# MinIO S3-compatible Storage
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tracks

# Storage Locations
# Set custom paths to store persistent data, or leave unset to use Docker named volumes.
# Example: PG_DATA_LOCATION=/mnt/nfs-jb02/docker/soundraft/pg_data
# PG_DATA_LOCATION=
# Example: UPLOADS_LOCATION=/mnt/nfs-jb02/docker/soundraft/minio_data
# UPLOADS_LOCATION=

# CORS Origin (comma-separated list of allowed origins for production)
# CORS_ORIGIN=https://your-domain.com

# Vite Dev Server - Allowed Hosts (comma-separated)
# Add your domain here to allow access from that host
VITE_ALLOWED_HOSTS=localhost
