# SoundRaft local environment file
# For production, customize these values.

JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

DB_USER=soundraft
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=soundraft

S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET=tracks

PORT=8080

# Persistent storage paths (host bind mounts)
PG_DATA_LOCATION=./data/postgres
UPLOADS_LOCATION=./data/storage
CADDY_DATA_LOCATION=./data/caddy/data
CADDY_CONFIG_LOCATION=./data/caddy/config

# Optional
# CORS_ORIGIN=https://your-domain.com
# DOMAIN=your-domain.com
