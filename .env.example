# ── SoundRaft production configuration ─────────────────────────────────────────
# 1) Copy this file to .env
# 2) Fill in REQUIRED fields
# 3) Run: docker compose up -d

# ── App security ───────────────────────────────────────────────────────────────
# REQUIRED: openssl rand -hex 32
JWT_SECRET=

# ── Initial admin account (created on first boot) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
# REQUIRED: use a strong password
ADMIN_PASSWORD=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_USER=soundraft
# REQUIRED: openssl rand -hex 16
DB_PASSWORD=
DB_NAME=soundraft

# ── Object storage (MinIO / S3-compatible) ─────────────────────────────────────
# REQUIRED: openssl rand -hex 16
S3_ACCESS_KEY=
# REQUIRED: openssl rand -hex 16
S3_SECRET_KEY=
S3_BUCKET=tracks

# ── Networking ─────────────────────────────────────────────────────────────────
# Public app port on host
PORT=8080
# Optional CORS allowlist (comma-separated), e.g. https://music.example.com
# CORS_ORIGIN=

# Short-lived, resource-scoped URLs used by audio and cover-art elements
RESOURCE_GRANT_TTL=1h

# Upload and account quotas (bytes)
AUDIO_UPLOAD_MAX_BYTES=524288000
ATTACHMENT_UPLOAD_MAX_BYTES=524288000
COVER_UPLOAD_MAX_BYTES=20971520
USER_STORAGE_QUOTA_BYTES=21474836480

# Object deletion retry worker and bounded export deadlines
OBJECT_RECONCILE_INTERVAL_MS=30000
OBJECT_RECONCILE_BATCH_SIZE=20
OBJECT_STAGE_TTL_MINUTES=60
EXPORT_QUERY_TIMEOUT_MS=30000
EXPORT_TIMEOUT_MS=900000

# Example track and playlist are opt-in; production defaults to no seed content
SEED_EXAMPLE_CONTENT=false

# ── Persistent data locations ──────────────────────────────────────────────────
# These default to host folders so backups/migrations are straightforward.
# Use absolute paths for external disks/NAS.
PG_DATA_LOCATION=./data/postgres
UPLOADS_LOCATION=./data/storage

# Optional Caddy persistence (only used with --profile proxy)
CADDY_DATA_LOCATION=./data/caddy/data
CADDY_CONFIG_LOCATION=./data/caddy/config

# ── Optional reverse proxy / HTTPS ─────────────────────────────────────────────
# DOMAIN=music.example.com

# ── Alternative persistence mode (Docker named volumes) ────────────────────────
# PG_DATA_LOCATION=pg_data
# UPLOADS_LOCATION=minio_data

# Request/process budgets. Trust only actual proxy addresses/CIDRs; direct deployments leave empty.
TRUST_PROXY=
REQUEST_LOGGING=true
DB_POOL_SIZE=10
DB_ACQUIRE_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_TRANSACTION_IDLE_TIMEOUT_MS=30000
STORAGE_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=30000
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_EXPORTS=2
MAX_EXPORT_ENTRIES=20000
