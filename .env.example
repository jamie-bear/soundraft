# ── SoundRaft Configuration ──
# Copy this file to .env and fill in all REQUIRED values before starting.

# ── Authentication ──
# REQUIRED — Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Admin Account (seeded on first run) ──
ADMIN_EMAIL=admin@example.com
# REQUIRED — Set a strong password (min 8 characters)
ADMIN_PASSWORD=

# ── Database ──
DB_USER=soundraft
# REQUIRED — Generate with: openssl rand -hex 16
DB_PASSWORD=
DB_NAME=soundraft

# ── Object Storage (MinIO) ──
# REQUIRED — Generate with: openssl rand -hex 16
S3_ACCESS_KEY=
# REQUIRED — Generate with: openssl rand -hex 16
S3_SECRET_KEY=
S3_BUCKET=tracks
# ── Storage Locations ──
# Host paths for persistent data (leave empty to use Docker named volumes)
PG_DATA_LOCATION=./data/db
UPLOADS_LOCATION=./data/storage

# ── Networking ──
# Set to your domain in production (comma-separated for multiple)
# CORS_ORIGIN=https://your-domain.com
PORT=8080

# ── Optional: Reverse Proxy ──
# Uncomment and set for automatic HTTPS via Caddy
# DOMAIN=your-domain.com

# ── Backup Commands ──
# Backup DB:      docker compose exec db pg_dump -U $DB_USER $DB_NAME > backup.sql
# Restore DB:     docker compose exec -T db psql -U $DB_USER $DB_NAME < backup.sql
# Backup storage: docker compose cp storage:/data ./storage-backup
